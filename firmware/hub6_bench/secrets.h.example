#pragma once
// Copy to secrets.h and list the 2.4 GHz access points (secrets.h is not in git).
//
// Use the same list, in the same order, as exp-cubic-earth's espnow_bridge (and its lt7680_multi):
// every device joins the first AP of the list that its scan sees, and ESP-NOW rides on that AP's
// channel, so with the same list they all end up on the same channel.
#define WIFI_APS { \
    {"your_home_24ghz_ssid", "your_home_password"}, \
    {"your_phone_hotspot",   "your_hotspot_password"}, \
}
